<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_envia">
        <field name="name">Envia Shipping</field>
        <field name="category_id" ref="base.module_category_inventory"/>
    </record>

    <record id="group_envia_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_envia"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_envia_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_envia"/>
        <field name="implied_ids" eval="[(4, ref('group_envia_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="envia_quote_comp_rule" model="ir.rule">
        <field name="name">Envia Quote: multi-company</field>
        <field name="model_id" ref="model_envia_quote"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="envia_shipment_comp_rule" model="ir.rule">
        <field name="name">Envia Shipment: multi-company</field>
        <field name="model_id" ref="model_envia_shipment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
