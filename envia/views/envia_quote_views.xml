<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_envia_quote_list" model="ir.ui.view">
        <field name="name">envia.quote.list</field>
        <field name="model">envia.quote</field>
        <field name="arch" type="xml">
            <list js_class="envia_quote_list" create="false"
                  decoration-muted="state == 'expired'"
                  decoration-success="selected_service_id">
                <field name="envia_show_quote_archive" column_invisible="True"/>
                <header>
                    <button name="action_open_quote_wizard" type="object"
                            string="New Quote" display="always" class="btn-primary"
                            invisible="not envia_show_quote_archive"/>
                </header>
                <field name="name"/>
                <field name="origin_postal_code" string="From"/>
                <field name="destination_postal_code" string="To"/>
                <field name="sale_order_id" optional="show"/>
                <field name="selected_service_label" string="Selected rate"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'quoted'"
                       decoration-info="state == 'used'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_envia_quote_form" model="ir.ui.view">
        <field name="name">envia.quote.form</field>
        <field name="model">envia.quote</field>
        <field name="arch" type="xml">
            <form create="false" class="o_envia_quote_form">
                <header>
                    <field name="envia_enable_labels" invisible="1"/>
                    <field name="envia_show_quote_archive" invisible="1"/>
                    <button name="action_open_create_shipment_wizard" type="object"
                            string="Generate Label" class="btn-primary"
                            invisible="not envia_enable_labels or state != 'quoted' or not selected_service_id"
                            icon="fa-print"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="quoted,used"/>
                </header>
                <sheet>
                    <field name="quote_id" invisible="1"/>
                    <field name="valid_until" invisible="1"/>
                    <field name="picking_id" invisible="1"/>

                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="service_ids">
                        No carrier rates yet. Use <strong>Add shipping</strong>
                        on a sale order to quote with Envia.
                    </div>

                    <div class="oe_title mb-3">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <p class="text-muted mb-0">
                            <field name="origin_postal_code" readonly="1" class="oe_inline"/>
                            <field name="origin_state" readonly="1" class="oe_inline"/>
                            <span>, </span>
                            <field name="origin_country" readonly="1" class="oe_inline"/>
                            <span> → </span>
                            <field name="destination_postal_code" readonly="1" class="oe_inline"/>
                            <field name="destination_state" readonly="1" class="oe_inline"/>
                            <span>, </span>
                            <field name="destination_country" readonly="1" class="oe_inline"/>
                        </p>
                    </div>

                    <group invisible="not selected_service_id">
                        <group string="Selected rate">
                            <field name="selected_service_label" readonly="1"/>
                        </group>
                        <group string="Source" invisible="not sale_order_id">
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Package" invisible="not service_ids">
                        <group>
                            <field name="weight" readonly="1"/>
                            <field name="content" readonly="1"/>
                            <field name="declared_value" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Available rates"
                               invisible="not envia_show_quote_archive or not service_ids"/>
                    <field name="service_ids" nolabel="1"
                           invisible="not envia_show_quote_archive or not service_ids">
                        <list create="false" delete="false" edit="false"
                              decoration-success="is_selected">
                            <field name="carrier_name"/>
                            <field name="service_name"/>
                            <field name="price"/>
                            <field name="currency_name"/>
                            <field name="estimated_delivery_days"/>
                            <field name="is_selected" column_invisible="True"/>
                            <button name="action_select_service" type="object"
                                    string="Select" class="btn-primary"
                                    invisible="is_selected or parent.state == 'used'"/>
                        </list>
                    </field>

                    <separator string="Labels" invisible="not shipment_ids"/>
                    <field name="shipment_ids" nolabel="1" invisible="not shipment_ids">
                        <list create="false" delete="false">
                            <field name="name"/>
                            <field name="tracking_number"/>
                            <field name="carrier_name"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_envia_quote_wizard" model="ir.actions.act_window">
        <field name="name">Quote Shipment</field>
        <field name="res_model">envia.quote.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="action_envia_quote" model="ir.actions.act_window">
        <field name="name">Envia Quotes</field>
        <field name="res_model">envia.quote</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="action_envia_open_checkout_settings" model="ir.actions.server">
        <field name="name">Open Envia Checkout Settings</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = env.company.action_envia_open_checkout_settings()</field>
    </record>

    <record id="action_envia_checkout_settings_dashboard" model="ir.actions.server">
        <field name="name">Envia Checkout Settings Dashboard</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = env.company.action_envia_checkout_settings_dashboard()</field>
    </record>

    <record id="action_envia_open_shipping_rules_settings" model="ir.actions.server">
        <field name="name">Open Envia Shipping Rules Settings</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = env.company.action_envia_open_shipping_rules_settings()</field>
    </record>

    <record id="action_envia_shipping_rules_settings_dashboard" model="ir.actions.server">
        <field name="name">Envia Shipping Rules Settings Dashboard</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = env.company.action_envia_shipping_rules_settings_dashboard()</field>
    </record>

    <record id="action_envia_app_entry" model="ir.actions.server">
        <field name="name">Envia.com</field>
        <field name="model_id" ref="model_envia_plugin_connect_wizard"/>
        <field name="state">code</field>
        <field name="code">action = env["envia.plugin.connect.wizard"].action_envia_app_entry()</field>
    </record>

    <record id="action_envia_connect_store" model="ir.actions.server">
        <field name="name">Connect Store</field>
        <field name="model_id" ref="model_envia_plugin_connect_wizard"/>
        <field name="state">code</field>
        <field name="code">action = env["envia.plugin.connect.wizard"].action_open_connect_wizard()</field>
    </record>

    <record id="action_envia_dashboard_client" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">envia_dashboard</field>
        <field name="target">current</field>
    </record>

    <record id="action_envia_dashboard" model="ir.actions.server">
        <field name="name">Dashboard</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = env["res.company"].action_open_envia_dashboard()</field>
    </record>

    <menuitem id="menu_envia_root" name="Envia.com" sequence="50" action="action_envia_app_entry"
              web_icon="envia,static/description/icon.png"/>
    <menuitem id="menu_envia_dashboard" name="Dashboard" parent="menu_envia_root"
              action="action_envia_dashboard" sequence="1"
              groups="envia.group_envia_user"/>
    <menuitem id="menu_envia_quote_wizard" name="Quote Shipment" parent="menu_envia_root"
              action="action_envia_quote_wizard" sequence="5" active="False"/>
    <menuitem id="menu_envia_quotes" name="Quotes" parent="menu_envia_root"
              action="action_envia_quote" sequence="10" active="False"/>
    <menuitem id="menu_envia_configuration" name="Administration" parent="menu_envia_root"
              sequence="90" groups="base.group_system"/>
    <menuitem id="menu_envia_settings" name="Settings" parent="menu_envia_configuration"
              action="action_envia_config_settings" sequence="10"/>
    <menuitem id="menu_envia_connect_store" name="Connect Store" parent="menu_envia_configuration"
              action="action_envia_connect_store" sequence="20"/>
</odoo>
