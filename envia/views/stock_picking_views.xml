<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_envia" model="ir.ui.view">
        <field name="name">stock.picking.form.envia</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="envia_status" invisible="1"/>
                <field name="envia_service_id" invisible="1"/>
                <field name="envia_module" invisible="1"/>
                <field name="envia_show_quote_archive" invisible="1"/>
                <div class="alert alert-success mb-0 rounded-0" role="alert"
                     invisible="envia_status != 'shipped'">
                    <field name="envia_summary" nolabel="1" readonly="1"/>
                </div>
                <div class="alert alert-info mb-0 rounded-0" role="alert"
                     invisible="envia_status != 'quoted'">
                    <field name="envia_summary" nolabel="1" readonly="1"/>
                </div>
            </xpath>
            <!-- Before statusbar so Envia CTAs sit with Validate, not after the pills. -->
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="envia_can_generate_label" invisible="1"/>
                <field name="envia_can_replace_label" invisible="1"/>
                <button name="action_envia_generate_label" type="object"
                        string="Generate Envia Label" class="btn-primary"
                        display="always"
                        invisible="not envia_can_generate_label"/>
                <button name="action_envia_replace_label" type="object"
                        string="Replace Envia Label" class="btn-primary"
                        display="always"
                        confirm="This unlinks the current Envia label in Odoo (it does not cancel it on Envia). You will quote again and generate a new label. Continue?"
                        invisible="not envia_can_replace_label"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_envia_quotes" class="oe_stat_button"
                        icon="fa-calculator"
                        invisible="envia_quote_count == 0 or not envia_show_quote_archive">
                    <field name="envia_quote_count" widget="statinfo" string="Envia Quotes"/>
                </button>
                <button type="object" name="action_view_envia_shipments" class="oe_stat_button"
                        icon="fa-truck" invisible="envia_shipment_count == 0">
                    <field name="envia_shipment_count" widget="statinfo" string="Envia Shipments"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Hide Core Send to Shipper / Cancel for Envia; Envia buttons own the UX. -->
    <record id="view_picking_withcarrier_out_form_envia" model="ir.ui.view">
        <field name="name">delivery.stock.picking_withcarrier.form.envia</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_delivery.view_picking_withcarrier_out_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='send_to_shipper']" position="attributes">
                <attribute name="invisible">carrier_tracking_ref or delivery_type in ['fixed', 'base_on_rule', 'envia'] or not delivery_type or state != 'done' or picking_type_code == 'incoming'</attribute>
            </xpath>
            <xpath expr="//div[@name='tracking']/button[@name='cancel_shipment']" position="attributes">
                <attribute name="invisible">not carrier_tracking_ref or delivery_type in ['fixed', 'base_on_rule', 'envia'] or not delivery_type or state != 'done'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
