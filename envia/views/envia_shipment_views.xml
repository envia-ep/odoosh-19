<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_envia_shipment_list" model="ir.ui.view">
        <field name="name">envia.shipment.list</field>
        <field name="model">envia.shipment</field>
        <field name="arch" type="xml">
            <list create="false"
                  decoration-success="state == 'delivered'"
                  decoration-muted="state in ('cancelled', 'replaced')">
                <field name="name"/>
                <field name="tracking_number"/>
                <field name="carrier_name"/>
                <field name="service_name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'delivered'"
                       decoration-info="state == 'in_transit'"
                       decoration-muted="state == 'replaced'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="sale_order_id"/>
                <field name="picking_id"/>
            </list>
        </field>
    </record>

    <record id="view_envia_shipment_form" model="ir.ui.view">
        <field name="name">envia.shipment.form</field>
        <field name="model">envia.shipment</field>
        <field name="arch" type="xml">
            <!-- Label payload is system-owned once created; Open Label stays available. -->
            <form create="false" edit="false">
                <header>
                    <button name="action_open_label" type="object" string="Open Label"
                            class="btn-primary"
                            invisible="not label_url"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="draft,created,replaced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_label" class="oe_stat_button"
                                icon="fa-external-link"
                                invisible="not label_url">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Label</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title mb-3">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <p class="text-muted mb-0" invisible="not carrier_name">
                            <field name="carrier_name" readonly="1" class="oe_inline"/>
                            <span> · </span>
                            <field name="service_name" readonly="1" class="oe_inline"/>
                        </p>
                    </div>

                    <group>
                        <group string="Documents">
                            <field name="quote_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="picking_id" readonly="1"/>
                            <field name="external_shipment_id" readonly="1"/>
                            <field name="external_order_id" readonly="1"/>
                            <field name="tracking_number" readonly="1"/>
                        </group>
                        <group string="Status">
                            <field name="carrier" readonly="1"/>
                            <field name="status_description" readonly="1"/>
                            <field name="pricing_total" readonly="1"/>
                            <field name="pricing_currency_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Label">
                        <field name="label_url" widget="url" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_envia_shipment" model="ir.actions.act_window">
        <field name="name">Envia Shipments</field>
        <field name="res_model">envia.shipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_envia_shipments" name="Shipments" parent="menu_envia_root"
              action="action_envia_shipment" sequence="20"/>
</odoo>
