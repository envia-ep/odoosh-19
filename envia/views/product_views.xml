<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ponytail: Odoo hides native weight for storable products; Envia needs it on Inventory. -->
    <record id="product_template_form_view_shipping_weight" model="ir.ui.view">
        <field name="name">product.template.common.form.shipping.weight</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
