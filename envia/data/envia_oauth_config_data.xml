<?xml version="1.0" encoding="utf-8"?>
<!-- Default Envia endpoints and environment. Override via ENVIA_* env vars or Settings > Envia. -->
<odoo noupdate="1">
    <record id="config_envia_environment" model="ir.config_parameter">
        <field name="key">envia.environment</field>
        <field name="value">production</field>
    </record>

    <record id="config_envia_oauth_integration_url" model="ir.config_parameter">
        <field name="key">envia.oauth_integration_url</field>
        <field name="value">https://oauth.ecartapi.com/oauth/NrUAVHsfjTJUE0NacgA7mVSogkfTuWTW/integration/odoo</field>
    </record>

    <record id="config_envia_oauth_popup_url" model="ir.config_parameter">
        <field name="key">envia.oauth_popup_url</field>
        <field name="value">https://oauth.ecartapi.com/NrUAVHsfjTJUE0NacgA7mVSogkfTuWTW?ecommerce=odoo</field>
    </record>

    <record id="config_envia_oauth_use_sized_popup" model="ir.config_parameter">
        <field name="key">envia.oauth_use_sized_popup</field>
        <field name="value">False</field>
    </record>
</odoo>
