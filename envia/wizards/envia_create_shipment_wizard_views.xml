<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_envia_create_shipment_wizard_form" model="ir.ui.view">
        <field name="name">envia.create.shipment.wizard.form</field>
        <field name="model">envia.create.shipment.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Label" class="o_envia_create_label_wizard">
                <sheet>
                    <div class="oe_title mb-3">
                        <h1>Generate shipping label</h1>
                        <field name="route_summary" readonly="1" class="text-muted"
                               invisible="not route_summary"/>
                    </div>

                    <field name="quote_id" invisible="1"/>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="picking_id" invisible="1"/>

                    <div class="border rounded p-3 mb-3 bg-white o_envia_rate_card">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <span class="o_envia_stat_label">Carrier</span>
                                <field name="selected_carrier_name" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-md-4">
                                <span class="o_envia_stat_label">Service</span>
                                <field name="selected_service_name" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-md-4">
                                <span class="o_envia_stat_label">Price</span>
                                <div class="o_row">
                                    <field name="selected_price" readonly="1" nolabel="1" class="oe_inline"/>
                                    <field name="selected_currency_name" readonly="1" nolabel="1"
                                           class="oe_inline ms-1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="o_envia_address_preview">
                        <field name="package_summary" readonly="1" nolabel="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_create_shipment" type="object"
                            string="Generate Label" class="btn-primary"
                            icon="fa-print"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
