<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_envia_quote_wizard_form" model="ir.ui.view">
        <field name="name">envia.quote.wizard.form</field>
        <field name="model">envia.quote.wizard</field>
        <field name="arch" type="xml">
            <form string="Ship with Envia" class="o_envia_quote_wizard"
                  js_class="envia_quote_wizard_form">
                <sheet>
                    <field name="can_get_rates" invisible="1"/>
                    <field name="can_generate_label" invisible="1"/>
                    <field name="envia_enable_labels" invisible="1"/>
                    <field name="envia_branches_enabled" invisible="1"/>
                    <field name="sale_order_state" invisible="1"/>
                    <field name="origin_readonly" invisible="1"/>
                    <field name="destination_partner_readonly" invisible="1"/>
                    <field name="is_sandbox" invisible="1"/>
                    <field name="is_standalone" invisible="1"/>
                    <field name="selected_service_label" invisible="1"/>
                    <field name="selected_carrier_code" invisible="1"/>
                    <field name="show_origin_branch_picker" invisible="1"/>
                    <field name="show_destination_branch_picker" invisible="1"/>
                    <field name="step" invisible="1"/>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="picking_id" invisible="1"/>
                    <field name="origin_branch_count" invisible="1"/>
                    <field name="destination_branch_count" invisible="1"/>
                    <field name="origin_branch_load_error" invisible="1"/>
                    <field name="destination_branch_load_error" invisible="1"/>
                    <field name="origin_selected_branch_label" invisible="1"/>
                    <field name="destination_selected_branch_label" invisible="1"/>
                    <field name="origin_branch_line_ids" invisible="1"/>
                    <field name="destination_branch_line_ids" invisible="1"/>
                    <field name="service_line_ids" invisible="1"/>
                    <field name="validation_summary" invisible="1"/>
                    <field name="show_service_rates" invisible="1"/>
                    <field name="allowed_origin_warehouse_ids" invisible="1"/>
                    <field name="allowed_destination_partner_ids" invisible="1"/>
                    <field name="origin_partner_id" invisible="1"/>
                    <field name="origin_address_count" invisible="1"/>
                    <field name="destination_address_count" invisible="1"/>
                    <field name="weight" invisible="1"/>
                    <field name="content" invisible="1"/>
                    <field name="declared_value" invisible="1"/>
                    <field name="currency_id" invisible="1"/>

                    <div class="oe_title mb-3">
                        <h1>Quote Shipment</h1>
                        <field name="route_summary" readonly="1" nolabel="1"
                               class="text-muted" invisible="not route_summary"/>
                    </div>

                    <div class="alert alert-info mb-3" role="status"
                         invisible="not is_sandbox">
                        Sandbox works best with domestic MX routes.
                        <button name="action_fill_sandbox_test_route" type="object"
                                string="Use test route" class="btn btn-link btn-sm p-0"/>
                    </div>
                    <div class="alert alert-warning mb-3" role="status"
                         invisible="not weight_warning">
                        <field name="weight_warning" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning mb-3" role="status"
                         invisible="not origin_envia_sync_warning">
                        <field name="origin_envia_sync_warning" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info mb-3" role="status"
                         invisible="not envia_package_preview">
                        <div class="fw-bold mb-1">Envia package for quote</div>
                        <field name="envia_package_preview" readonly="1" nolabel="1"
                               class="o_envia_package_preview"/>
                        <div class="text-muted small mt-1">
                            Shipping rates are calculated with this Envia package weight.
                        </div>
                    </div>
                    <div class="alert alert-warning mb-3" role="status"
                         invisible="not envia_package_sync_hint">
                        <field name="envia_package_sync_hint" readonly="1" nolabel="1"/>
                    </div>

                    <group>
                        <group string="Origin" class="o_envia_side_panel">
                            <field name="origin_location_type" widget="radio"
                                   options="{'horizontal': true}"
                                   invisible="not envia_branches_enabled"/>

                            <div class="o_envia_side_body" colspan="2">
                                <field name="origin_warehouse_id" string="Warehouse"
                                       domain="[('id', 'in', allowed_origin_warehouse_ids)]"
                                       options="{'no_create': True, 'no_open': True}"
                                       readonly="origin_readonly"/>
                                <div class="text-muted small mt-1"
                                     invisible="not origin_linked_contact_display">
                                    <span class="fw-bold">Linked contact:</span>
                                    <field name="origin_linked_contact_display"
                                           class="d-inline"
                                           nolabel="1"
                                           readonly="1"/>
                                </div>
                                <group string="Address details" colspan="2"
                                       class="o_envia_address_fields mt-2">
                                    <field name="origin_street" string="Street"
                                           readonly="1"/>
                                    <field name="origin_street_number" string="Number"
                                           readonly="1"/>
                                    <field name="origin_district" string="District"
                                           readonly="1"/>
                                    <field name="origin_postal_code" string="Postal code"
                                           readonly="1"/>
                                    <field name="origin_city" string="City"
                                           readonly="1"/>
                                    <field name="origin_country_id" string="Country"
                                           options="{'no_open': True}"
                                           readonly="1"/>
                                    <field name="origin_state_id" string="State / Province"
                                           options="{'no_open': True, 'no_create': True}"
                                           readonly="1"/>
                                </group>
                                <button name="action_open_origin_warehouse" type="object"
                                        string="Edit warehouse"
                                        class="btn btn-link btn-sm p-0"
                                        invisible="not origin_warehouse_id or origin_readonly"/>
                                <div class="o_envia_side_hint mt-2"
                                     invisible="origin_location_type != 'branch'">
                                    Enter your business address above. You can drop the package at any branch of the carrier you choose.
                                </div>
                            </div>
                        </group>

                        <group string="Destination" class="o_envia_side_panel">
                            <field name="destination_location_type" widget="radio"
                                   options="{'horizontal': true}"
                                   invisible="not envia_branches_enabled"/>

                            <div class="o_envia_side_body" colspan="2">
                                <field name="destination_partner_id" string="Contact"
                                       context="{'show_address': 1, 'default_type': 'delivery'}"
                                       options="{'no_open': True}"
                                       readonly="destination_partner_readonly"/>
                                <group string="Address details" colspan="2"
                                       class="o_envia_address_fields mt-2">
                                    <field name="destination_street" string="Street"
                                           readonly="1"/>
                                    <field name="destination_street_number" string="Number"
                                           readonly="1"/>
                                    <field name="destination_district" string="District"
                                           readonly="1"/>
                                    <field name="destination_postal_code" string="Postal code"
                                           readonly="1"/>
                                    <field name="destination_city" string="City"
                                           readonly="1"/>
                                    <field name="destination_country_id" string="Country"
                                           options="{'no_open': True}"
                                           readonly="1"/>
                                    <field name="destination_state_id" string="State / Province"
                                           options="{'no_open': True, 'no_create': True}"
                                           readonly="1"/>
                                </group>
                                <button name="action_open_destination_partner" type="object"
                                        string="Edit contact"
                                        class="btn btn-link btn-sm p-0"
                                        invisible="not destination_partner_id"/>
                                <div class="o_envia_side_hint mt-2"
                                     invisible="destination_location_type != 'branch'">
                                    Enter the branch address and postal code where your customer will collect.
                                </div>
                            </div>
                        </group>
                    </group>

                    <div class="o_envia_section" invisible="not show_origin_branch_picker">
                        <div class="d-flex align-items-baseline justify-content-between gap-3 mb-2">
                            <div class="o_envia_section_title mb-0">Origin pickup locations</div>
                            <button name="action_load_origin_branches" type="object"
                                    string="Load pickup locations"
                                    class="btn btn-link btn-sm p-0"
                                    invisible="origin_branch_count"/>
                        </div>
                        <div class="alert alert-warning py-2 mb-2" role="status"
                             invisible="not origin_branch_load_error">
                            <field name="origin_branch_load_error" readonly="1" nolabel="1"/>
                        </div>
                        <div class="alert alert-light border o_envia_selected_rate_hint py-2 mb-2"
                             role="status"
                             invisible="not origin_selected_branch_label">
                            <i class="fa fa-check-circle text-success me-1" title="Selected"/>
                            <field name="origin_selected_branch_label" readonly="1" nolabel="1"/>
                        </div>
                        <field name="origin_branch_line_ids" nolabel="1"
                               class="o_envia_option_kanban" mode="kanban"
                               invisible="not origin_branch_count">
                            <kanban create="false" delete="false" class="o_envia_option_list">
                                <field name="is_selected"/>
                                <field name="side"/>
                                <field name="branch_code"/>
                                <field name="carrier"/>
                                <field name="option_label"/>
                                <field name="address_label"/>
                                <field name="price_label"/>
                                <templates>
                                    <t t-name="card">
                                        <div t-attf-class="o_envia_option_card #{record.is_selected.raw_value ? 'o_envia_option_selected' : ''}">
                                            <a href="#"
                                               class="o_envia_option_row o_envia_select_branch text-reset text-decoration-none"
                                               t-att-data-branch-side="record.side.raw_value"
                                               t-att-data-branch-code="record.branch_code.raw_value"
                                               t-att-data-carrier="record.carrier.raw_value">
                                                <span t-attf-class="o_envia_option_radio #{record.is_selected.raw_value ? 'o_envia_option_radio_checked' : ''}"/>
                                                <span class="flex-grow-1 min-w-0">
                                                    <span class="d-flex justify-content-between gap-3 align-items-start">
                                                        <span class="min-w-0">
                                                            <span class="badge text-bg-success o_envia_option_selected_badge mb-1"
                                                                  t-if="record.is_selected.raw_value">
                                                                Selected
                                                            </span>
                                                            <span class="fw-bold d-block" t-out="record.option_label.value"/>
                                                            <span class="text-muted small d-block"
                                                                  t-if="record.address_label.value"
                                                                  t-out="record.address_label.value"/>
                                                        </span>
                                                        <span class="fw-bold text-nowrap"
                                                              t-if="record.price_label.value"
                                                              t-out="record.price_label.value"/>
                                                    </span>
                                                </span>
                                            </a>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </div>

                    <div class="o_envia_section" invisible="not show_destination_branch_picker">
                        <div class="d-flex align-items-baseline justify-content-between gap-3 mb-2">
                            <div class="o_envia_section_title mb-0">Destination pickup locations</div>
                            <button name="action_load_destination_branches" type="object"
                                    string="Load pickup locations"
                                    class="btn btn-link btn-sm p-0"
                                    invisible="destination_branch_count"/>
                        </div>
                        <div class="alert alert-warning py-2 mb-2" role="status"
                             invisible="not destination_branch_load_error">
                            <field name="destination_branch_load_error" readonly="1" nolabel="1"/>
                        </div>
                        <div class="alert alert-light border o_envia_selected_rate_hint py-2 mb-2"
                             role="status"
                             invisible="not destination_selected_branch_label">
                            <i class="fa fa-check-circle text-success me-1" title="Selected"/>
                            <field name="destination_selected_branch_label" readonly="1" nolabel="1"/>
                        </div>
                        <field name="destination_branch_line_ids" nolabel="1"
                               class="o_envia_option_kanban" mode="kanban"
                               invisible="not destination_branch_count">
                            <kanban create="false" delete="false" class="o_envia_option_list">
                                <field name="is_selected"/>
                                <field name="side"/>
                                <field name="branch_code"/>
                                <field name="carrier"/>
                                <field name="option_label"/>
                                <field name="address_label"/>
                                <field name="price_label"/>
                                <templates>
                                    <t t-name="card">
                                        <div t-attf-class="o_envia_option_card #{record.is_selected.raw_value ? 'o_envia_option_selected' : ''}">
                                            <a href="#"
                                               class="o_envia_option_row o_envia_select_branch text-reset text-decoration-none"
                                               t-att-data-branch-side="record.side.raw_value"
                                               t-att-data-branch-code="record.branch_code.raw_value"
                                               t-att-data-carrier="record.carrier.raw_value">
                                                <span t-attf-class="o_envia_option_radio #{record.is_selected.raw_value ? 'o_envia_option_radio_checked' : ''}"/>
                                                <span class="flex-grow-1 min-w-0">
                                                    <span class="d-flex justify-content-between gap-3 align-items-start">
                                                        <span class="min-w-0">
                                                            <span class="badge text-bg-success o_envia_option_selected_badge mb-1"
                                                                  t-if="record.is_selected.raw_value">
                                                                Selected
                                                            </span>
                                                            <span class="fw-bold d-block" t-out="record.option_label.value"/>
                                                            <span class="text-muted small d-block"
                                                                  t-if="record.address_label.value"
                                                                  t-out="record.address_label.value"/>
                                                        </span>
                                                        <span class="fw-bold text-nowrap"
                                                              t-if="record.price_label.value"
                                                              t-out="record.price_label.value"/>
                                                    </span>
                                                </span>
                                            </a>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </div>

                    <div class="o_envia_section o_envia_rates_section" invisible="not show_service_rates">
                        <div class="d-flex align-items-baseline justify-content-between gap-3 mb-2">
                            <div class="o_envia_section_title mb-0">Rates</div>
                            <div class="text-success small" invisible="not cheapest_rate_label">
                                <field name="cheapest_rate_label" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                        <field name="service_line_ids" nolabel="1"
                               class="o_envia_option_kanban" mode="kanban">
                            <kanban create="false" delete="false" class="o_envia_option_list">
                                <field name="is_selected"/>
                                <field name="service_id"/>
                                <field name="option_label"/>
                                <field name="price_label"/>
                                <field name="route_type_label"/>
                                <templates>
                                    <t t-name="card">
                                        <div t-attf-class="o_envia_option_card #{record.is_selected.raw_value ? 'o_envia_option_selected' : ''}">
                                            <a href="#"
                                               class="o_envia_option_row o_envia_select_rate text-reset text-decoration-none"
                                               t-att-data-service-id="record.service_id.raw_value">
                                                <span t-attf-class="o_envia_option_radio #{record.is_selected.raw_value ? 'o_envia_option_radio_checked' : ''}"/>
                                                <span class="flex-grow-1 min-w-0">
                                                    <span class="d-flex justify-content-between gap-3 align-items-start">
                                                        <span class="min-w-0">
                                                            <span class="fw-bold d-block" t-out="record.option_label.value"/>
                                                            <span class="badge rounded-pill o_envia_route_type_badge"
                                                                  t-if="record.route_type_label.value"
                                                                  t-out="record.route_type_label.value"/>
                                                        </span>
                                                        <span class="fw-bold text-nowrap" t-out="record.price_label.value"/>
                                                    </span>
                                                </span>
                                            </a>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </div>
                </sheet>
                <footer>
                    <div class="me-auto">
                        <div class="text-danger" role="alert"
                             invisible="can_get_rates or not blocking_message">
                            <field name="blocking_message" readonly="1" nolabel="1"/>
                        </div>
                        <div class="text-muted" invisible="not selected_service_label">
                            <field name="selected_service_label" readonly="1" nolabel="1"/>
                        </div>
                        <div class="text-warning" role="status"
                             invisible="can_generate_label or not selected_service_label">
                            Select the required pickup locations to generate the label.
                        </div>
                    </div>
                    <button name="action_get_quote" type="object"
                            string="Get Rates" class="btn-primary"
                            invisible="not can_get_rates or service_line_ids"/>
                    <button name="action_confirm_selection" type="object"
                            string="Generate Label" class="btn-primary"
                            invisible="not envia_enable_labels or not can_generate_label"/>
                    <button name="action_discard" type="object"
                            string="Discard" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
