<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Ecart Pay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'ecartpay'"
                       name="ecartpay_credentials">
                    <field name="ecartpay_public_key"
                           string="Public Key"
                           required="code == 'ecartpay' and state != 'disabled'"/>
                    <field name="ecartpay_private_key"
                           string="Private Key"
                           required="code == 'ecartpay' and state != 'disabled'"
                           password="True"/>
                    <field name="ecartpay_webhook_secret"
                           string="Webhook Secret"
                           readonly="1"
                           password="True"
                           help="Fetched automatically from Ecart Pay when the provider is saved. No manual input is required."/>
                </group>
            </group>
        </field>
    </record>

</odoo>
